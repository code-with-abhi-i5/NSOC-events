# Environment Variables for NSOC Events Platform (100% Free Setup)
# Copy this file to .env and fill in your values

# Firebase Client Configuration (Free Spark Plan: Auth & Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 100% Free Email Dispatch via Google Apps Script (Gmail)
# Deploy google_apps_script.js as a Web App and paste the URL here:
VITE_GAS_WEBHOOK_URL=

# App URLs
VITE_APP_URL=https://nsoc-events.vercel.app
VITE_VERIFICATION_DOMAIN=https://nsoc-events.vercel.app
